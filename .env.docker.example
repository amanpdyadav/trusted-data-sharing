# Docker / VPS settings. On the server: cp .env.docker.example .env, then fill in. Never commit .env.
# (docker compose reads .env next to docker-compose.yml; the container only gets the variables listed in the compose file.)

# Public hostname Traefik routes to the app (DNS A/AAAA record must point at the VPS)
APP_DOMAIN=pets.example.com

# Must match your Traefik's static config: entrypoint name for :443 and the ACME cert resolver name
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

# Master secret for keyed pseudonyms (32+ chars). Generate with:  openssl rand -base64 48
# Back it up: without the same key, pseudonyms cannot be reproduced across releases.
PETS_MASTER_KEY=change-me-to-a-long-random-secret-of-32-plus-chars

# Host folder holding the TrustED data package (its data/ subfolder gives the sample datasets). Mounted read-only.
PETS_PACKAGE_HOST_DIR=./TRUSTED_PETS_PROVING_GROUND_2026

# Optional AI that suggests names for unnamed columns. Off by default; everything works without it.
# Ollama:              PETS_LLM_URL=http://host:11434            (PETS_LLM_API=ollama, the default)
# OpenAI-style server: PETS_LLM_URL=http://host:4000/v1          (LiteLLM, vLLM, llama.cpp; detected from /v1)
# A host other than localhost must be named in PETS_LLM_ALLOWED_HOSTS: sample values of each unnamed column go to it.
PETS_LLM_ENABLED=false
PETS_LLM_URL=http://aipc.tail952c00.ts.net:4000/v1
PETS_LLM_MODEL=qwen2.5-7b-instruct
PETS_LLM_API_KEY=
PETS_LLM_TIMEOUT_S=60
PETS_LLM_ALLOWED_HOSTS=aipc.tail952c00.ts.net
