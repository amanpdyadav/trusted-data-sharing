# Copy to .env (never commit .env). The command line loads it automatically.
# Anything you `export` in your shell, or set on a server, wins over this file.

# Master secret for keyed pseudonyms. At least 32 characters. Per-receiver keys are derived from it.
PETS_MASTER_KEY=change-me-to-a-long-random-secret-of-32-plus-chars

# Where the TrustED data package lives, and where outputs go.
PETS_PACKAGE_ROOT=./TRUSTED_PETS_PROVING_GROUND_2026
PETS_OUT_DIR=./out

# Extra scenario folders (company presets), separated by ':' on macOS/Linux.
PETS_SCENARIO_DIRS=scenarios
# Code lists that group codes for published statistics (e.g. diagnosis_group.yaml)
PETS_CODELIST_DIR=codelists

# Local AI (Ollama). Optional: everything works with it off. Must be a localhost URL.
PETS_LLM_ENABLED=false
PETS_LLM_URL=http://localhost:11434
PETS_LLM_MODEL=qwen2.5:7b
PETS_LLM_TIMEOUT_S=60
